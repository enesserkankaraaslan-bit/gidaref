{
  "name": "gidaref",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gıda mühendisleri için resmî kaynaklı mevzuat başucu uygulaması (PWA)",
  "scripts": {
    "//": "Araçlar node ile doğrudan çağrılır: klasör yolunda '&' olduğunda (ör. C:\\Users\\A&B) node_modules/.bin/*.cmd kısayolları cmd.exe'de bozuluyor.",
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "pdfjs-dist": "4.7.76"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "22.9.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.21.0",
    "vitest": "2.1.5"
  }
}
